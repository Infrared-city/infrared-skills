    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Infrared Ground. No logic here: all of it is in the libs folder.\nimport os, sys, importlib\nlibs = os.path.expandvars(IN[0])\nif libs not in sys.path:\n    sys.path.insert(0, libs)\nfor name in ('ir_dynamo.settings', 'ir_dynamo.frame', 'ir_dynamo.meshes', 'ir_dynamo.payloads', 'ir_dynamo.results', 'ir_dynamo.env', 'ir_dynamo.run', 'ir_revit.revit_location', 'ir_revit.revit_geometry', 'ir_revit.result_mesh', 'ir_revit.revit_display', 'ir_revit.revit_apikey', 'ir_revit.entry'):\n    importlib.reload(importlib.import_module(name))  # picks up edited files\nfrom ir_revit.entry import run\nOUT = run('ground', IN[1], IN[2], IN[3], IN[4], IN[5], IN[6], IN[7], IN[8], set_api_key=IN[11], wind_speed=IN[9], wind_direction=IN[10])\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "6212656f0f1b44c3b5c99dbbc7884439",
      "NodeType": "PythonScriptNode",
