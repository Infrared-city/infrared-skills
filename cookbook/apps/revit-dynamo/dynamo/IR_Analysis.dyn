    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Infrared analysis for Revit. No logic here: all of it is in the libs folder.\n# IN[0] is the command line. The buildings are the selection of Revit.\nimport os, sys, traceback\ntry:\n    # The folder of the unzipped libs. INFRARED_DYNAMO_LIBS names another folder.\n    libs = os.environ.get('INFRARED_DYNAMO_LIBS') or os.path.join(os.environ.get('APPDATA', ''), 'Infrared', 'revit-dynamo')\n    if not os.path.isdir(os.path.join(libs, 'ir_revit')):\n        raise RuntimeError('The Infrared libs are not in %s. Unzip infrared-dynamo-libs.zip there (see the README).' % libs)\n    if libs not in sys.path:\n        sys.path.insert(0, libs)\n    # Forget the loaded ir_* modules: the next import reads every edited file again.\n    # (importlib.reload one by one can leave an old module in place.)\n    for name in [m for m in sys.modules if m.split('.')[0] in ('ir_dynamo', 'ir_revit')]:\n        del sys.modules[name]\n    from ir_revit.entry import run\n    OUT = run(command=IN[0])\nexcept Exception:\n    OUT = ['Script error (also in ~/.infrared/revit-dynamo-runs.log):'] + traceback.format_exc().splitlines()\n    try:\n        with open(os.path.join(os.path.expanduser('~'), '.infrared', 'revit-dynamo-runs.log'), 'a') as log:\n            log.write('=== script error\\n' + traceback.format_exc() + '\\n')\n    except Exception:\n        pass\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "6212656f0f1b44c3b5c99dbbc7884439",
      "NodeType": "PythonScriptNode",
