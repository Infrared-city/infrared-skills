    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Infrared analysis (ground, facades or both). No logic here: all of it is in the libs folder.\nimport os, sys, importlib, traceback\ntry:\n    libs = os.path.expandvars(IN[0])\n    if libs not in sys.path:\n        sys.path.insert(0, libs)\n    for name in ('ir_dynamo.settings', 'ir_dynamo.colors', 'ir_dynamo.targets', 'ir_dynamo.frame', 'ir_dynamo.terrain', 'ir_dynamo.meshes', 'ir_dynamo.payloads', 'ir_dynamo.results', 'ir_dynamo.env', 'ir_dynamo.run', 'ir_revit.revit_location', 'ir_revit.revit_geometry', 'ir_revit.result_mesh', 'ir_revit.revit_display', 'ir_revit.revit_apikey', 'ir_revit.entry'):\n        importlib.reload(importlib.import_module(name))  # picks up edited files\n    from ir_revit.entry import run\n    OUT = run(target=IN[2], elements=IN[1], analysis=IN[3], months=IN[4], hours=IN[5], preview_only=IN[6], fetch_context=IN[7], lat=IN[8], lon=IN[9], wind_speed=IN[10], wind_direction=IN[11], surfaces=IN[12], set_api_key=IN[13], legend=IN[14])\nexcept Exception:\n    OUT = ['Script error (also in ~/.infrared/revit-dynamo-runs.log):'] + traceback.format_exc().splitlines()\n    try:\n        with open(os.path.join(os.path.expanduser('~'), '.infrared', 'revit-dynamo-runs.log'), 'a') as log:\n            log.write('=== script error\\n' + traceback.format_exc() + '\\n')\n    except Exception:\n        pass\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "6212656f0f1b44c3b5c99dbbc7884439",
      "NodeType": "PythonScriptNode",
